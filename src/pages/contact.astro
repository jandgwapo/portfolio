---
import ContactForm from '../components/ContactForm';
import IconArrow from '../components/IconArrow.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SocialIcon from '../components/SocialIcon.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — Jandy Arpon"
  description="Start a conversation with Jandy Arpon about a web application, mobile app, or full-stack system."
>
  <section class="container-shell page-hero pt-20 md:pt-32">
    <SectionLabel label="Contact" />
    <h1 class="mt-8 max-w-6xl text-[clamp(3.8rem,10vw,10.2rem)] font-medium leading-[0.84] tracking-[-0.105em]">
      Let’s build<br /><span class="display-serif">something useful.</span>
    </h1>
    <div class="mt-16 grid gap-12 border-t rule pt-8 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <div class="space-y-10">
        <div class="contact-availability">Currently open to useful work</div>
        <p class="max-w-sm text-lg leading-relaxed text-[var(--muted)]">
          Have a website, mobile app, or business system in mind? Tell me what you need to build, improve, or connect,
          and I’ll get back to you within a few working days.
        </p>
        <div class="grid max-w-md gap-4 border-y rule py-5 sm:grid-cols-2">
          <div>
            <p class="footer-kicker mb-2">Typical reply</p>
            <p class="text-sm font-semibold">Within a few working days</p>
          </div>
          <div>
            <p class="footer-kicker mb-2">Best for</p>
            <p class="text-sm font-semibold">Websites, systems, and apps</p>
          </div>
        </div>
        <div>
          <p class="mb-3 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[var(--muted)]">Direct line</p>
          <a
            class="group inline-flex items-center gap-2 border-b border-[var(--foreground)] pb-2 text-lg font-medium"
            href="mailto:jansnww@gmail.com">jansnww@gmail.com <IconArrow /></a
          >
        </div>
        <div>
          <p class="mb-3 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[var(--muted)]">Elsewhere</p>
          <div class="flex flex-wrap gap-2">
            <a
              class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--muted)] transition-colors hover:text-[var(--foreground)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-deep)]"
              href="mailto:jansnww@gmail.com"
              aria-label="Email Jandy Arpon"
              title="Email Jandy Arpon"
            >
              <SocialIcon platform="email" />
            </a>
            <a
              class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--muted)] transition-colors hover:text-[var(--foreground)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-deep)]"
              href="https://github.com/jandgwapo"
              target="_blank"
              rel="noreferrer"
              aria-label="Visit Jandy Arpon on GitHub"
              title="GitHub"
            >
              <SocialIcon platform="github" />
            </a>
            <a
              class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--muted)] transition-colors hover:text-[var(--foreground)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-deep)]"
              href="https://www.linkedin.com/in/jandy-arpon-670b833b7"
              target="_blank"
              rel="noreferrer"
              aria-label="Visit Jandy Arpon on LinkedIn"
              title="LinkedIn"
            >
              <SocialIcon platform="linkedin" />
            </a>
            <a
              class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--muted)] transition-colors hover:text-[var(--foreground)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-deep)]"
              href="https://www.instagram.com/_jansnoww/"
              target="_blank"
              rel="noreferrer"
              aria-label="Visit Jandy Arpon on Instagram"
              title="Instagram"
            >
              <SocialIcon platform="instagram" />
            </a>
          </div>
        </div>
      </div>
      <div class="surface-card p-6 md:p-10">
        <p class="eyebrow">Project brief</p>
        <h2 class="mt-4 text-2xl font-medium tracking-[-0.05em]">Tell me what you’re working on.</h2>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-[var(--muted)]">
          A few details about the goal, timeline, and current challenge are enough to start.
        </p>
        <div class="mt-8 border-t rule pt-8"><ContactForm client:load /></div>
      </div>
    </div>
  </section>
  <section class="container-shell pb-24 pt-24 md:pb-40 md:pt-36">
    <div class="border-t rule pt-6">
      <p class="max-w-xl text-[clamp(2rem,4vw,4.5rem)] font-medium leading-[0.95] tracking-[-0.08em]">
        Clean frontend.<br /><span class="text-[var(--muted)]">Reliable backend.</span>
      </p>
    </div>
  </section>
</Layout>
