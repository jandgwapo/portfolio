---
import IconArrow from '../../components/IconArrow.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ProjectTools from '../../components/ProjectTools.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';

type StudyModule = {
  default: any;
};

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const studyModules = import.meta.glob('../../content/projects/*.mdx', { eager: true });
const study = studyModules[`../../content/projects/${project.slug}.mdx`] as StudyModule | undefined;
const Content = study?.default;
const projectIndex = projects.findIndex((item) => item.slug === project.slug);
const previousProject = projects[(projectIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(projectIndex + 1) % projects.length];
---

<Layout title={`${project.title} — Jandy Arpon`} description={project.description}>
  <article>
    <section class="container-shell pt-20 md:pt-32">
      <nav
        class="flex flex-wrap items-center justify-between gap-5 border-b rule pb-5 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[var(--muted)]"
        aria-label="Project navigation"
      >
        <a class="transition-colors hover:text-[var(--foreground)]" href="/projects">← All projects</a>
        <span>Project {project.number} / {project.year}</span>
      </nav>
      {
        project.liveUrl ? (
          <div class="case-study-live-preview project-image live-site-preview relative mt-8 aspect-[16/10] w-full md:mt-12 md:w-1/2">
            <iframe
              src={project.liveUrl}
              title={`${project.title} live homepage`}
              loading="eager"
              referrerpolicy="no-referrer"
              class="absolute inset-0 block h-full w-full border-0 bg-[var(--background-raised)]"
            />
            <span class="pointer-events-none absolute bottom-4 left-4 bg-[var(--accent)] px-3 py-2 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-[#020202]">
              Live homepage
            </span>
          </div>
        ) : (
          <ProjectVisual
            src={project.image}
            alt={project.imageAlt}
            className="case-study-live-preview mt-8 aspect-[1.2/1] md:mt-12 md:aspect-[2.2/1]"
            loading="eager"
          />
        )
      }
      <div class="grid gap-10 py-12 md:grid-cols-[1.15fr_0.85fr] md:gap-16 md:py-16">
        <div>
          <SectionLabel label={project.category} />
          <h1 class="mt-7 max-w-5xl text-[clamp(3.8rem,10vw,10rem)] font-medium leading-[0.82] tracking-[-0.105em]">
            {project.title}
          </h1>
        </div>
        <div class="surface-card p-6 md:p-8">
          <p class="eyebrow">Project overview</p>
          <p class="mt-5 text-xl leading-snug tracking-[-0.03em]">{project.description}</p>
          <div class="mt-8 grid gap-4 border-t rule pt-5 text-sm">
            <div class="flex items-start justify-between gap-5">
              <span class="text-[var(--muted)]">Role</span>
              <span class="max-w-[12rem] text-right font-semibold">{project.role}</span>
            </div>
            <div class="flex items-start justify-between gap-5">
              <span class="text-[var(--muted)]">Category</span>
              <span class="text-right font-semibold">{project.category}</span>
            </div>
            <div class="flex items-start justify-between gap-5">
              <span class="text-[var(--muted)]">Status</span>
              <span class="text-right font-semibold">{project.year}</span>
            </div>
          </div>
          <div class="mt-7 border-t rule pt-5">
            <p class="mb-3 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[var(--muted)]">Built with</p>
            <ProjectTools tools={project.tools} compact />
          </div>
          {
            project.liveUrl && (
              <a class="button-primary mt-7 w-full" href={project.liveUrl} target="_blank" rel="noreferrer">
                Visit live site <IconArrow />
              </a>
            )
          }
        </div>
      </div>
    </section>
    <section class="container-shell section-space">
      <div class="grid gap-12 border-t rule pt-10 md:grid-cols-[0.8fr_1.2fr] md:gap-20 md:pt-16">
        <div class="md:sticky md:top-24 md:self-start">
          <SectionLabel label="The case study" />
          <p class="mt-5 max-w-xs text-sm leading-relaxed text-[var(--muted)]">
            A closer look at the context, decisions, tools, and details behind the work.
          </p>
        </div>
        <div class="prose-case-study">
          {Content ? <Content /> : <p>This case study is being written. Check back soon for the full story.</p>}
        </div>
      </div>
    </section>
    <section class="container-shell border-t rule pb-24 pt-8 md:pb-40">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">Continue exploring</p>
          <h2 class="mt-4 max-w-3xl text-[clamp(2.7rem,6vw,6.5rem)] font-medium leading-[0.85] tracking-[-0.095em]">
            More work worth a <span class="display-serif">closer look.</span>
          </h2>
        </div>
        <p class="max-w-xs text-sm leading-relaxed text-[var(--muted)]">
          Compare another project or return to the full list to see the work by category.
        </p>
      </div>
      <div class="mt-10 grid gap-3 border-t rule pt-5 sm:grid-cols-2">
        <a class="group flex items-center justify-between gap-4 py-3 text-sm font-semibold" href={'/projects/' + previousProject.slug}>
          <span>
            <span class="mb-1 block font-mono text-[0.55rem] uppercase tracking-[0.08em] text-[var(--muted)]">Previous project</span>
            {previousProject.title}
          </span>
          <span class="text-lg transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
        </a>
        <a class="group flex items-center justify-between gap-4 border-t rule py-3 text-sm font-semibold sm:border-l sm:border-t-0 sm:pl-5" href={'/projects/' + nextProject.slug}>
          <span>
            <span class="mb-1 block font-mono text-[0.55rem] uppercase tracking-[0.08em] text-[var(--muted)]">Next project</span>
            {nextProject.title}
          </span>
          <span class="text-lg transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </article>
</Layout>
