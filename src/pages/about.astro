---
import IconArrow from '../components/IconArrow.astro';
import GithubContributions from '../components/GithubContributions.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../utils/site-path';
---

<Layout
  title="About — Jandy Arpon"
  description="A little more about Jandy Arpon, a full-stack web developer and Flutter mobile app developer based in the Philippines."
>
  <section class="container-shell page-hero pt-20 md:pt-32">
    <SectionLabel label="About Jandy" />
    <h1 class="mt-8 max-w-6xl text-[clamp(3.5rem,10vw,10rem)] font-medium leading-[0.86] tracking-[-0.1em]">
      Building products<br /><span class="display-serif">people can use.</span>
    </h1>
    <div
      class="mt-16 grid gap-10 border-t rule pt-6 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:gap-16 lg:gap-20"
    >
      <div class="relative w-full max-w-md md:max-w-none">
        <div class="project-image aspect-[4/5] w-full">
          <img
            src={sitePath('/me.png')}
            alt="Portrait of Jandy Arpon"
            loading="eager"
            decoding="async"
            width="1200"
            height="1500"
            class="h-full w-full object-cover"
          />
        </div>
        <div
          class="absolute -bottom-4 right-4 max-w-[13rem] bg-[var(--accent)] p-4 text-sm font-semibold leading-snug text-[#020202] sm:right-6"
        >
          Web, mobile, and full-stack development.
        </div>
      </div>
      <div
        class="max-w-3xl space-y-6 text-[clamp(1.25rem,2.3vw,2rem)] leading-[1.18] tracking-[-0.04em] md:self-center"
      >
        <p class="eyebrow">Full-Stack Developer + Mobile App Builder</p>
        <p>
          I’m Jandy Arpon, a full-stack web developer and Flutter mobile app developer based in the Philippines. I build
          websites, business systems, and mobile tools that make everyday work easier.
        </p>
        <p class="text-[var(--muted)]">
          My stack includes Flutter, PHP, Laravel, Tailwind CSS, React, Astro, MySQL, and Supabase. I care about clean
          interfaces, reliable data, and code that is practical to maintain.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a class="button-primary" href={sitePath('/projects')}>Explore my work <IconArrow /></a>
          <a class="button-secondary" href={sitePath('/contact')}>Start a conversation <IconArrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section id="experience" class="container-shell section-space">
    <div class="grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <SectionLabel index="01" label="Experience" />
      <div>
        <div class="border-t rule">
          <div class="grid gap-3 border-b rule py-6 md:grid-cols-[7rem_1fr_15rem] md:gap-8">
            <span class="text-sm text-[var(--muted)]">May 30 2026 — present</span>
            <div>
              <h2 class="text-xl font-medium tracking-[-0.04em]">Full stack web developer</h2>
              <p class="mt-2 max-w-lg text-sm leading-relaxed text-[var(--muted)]">
                Building and maintaining web applications, internal workflows, responsive interfaces, and data-driven
                tools for Emerald Mini Depot Corporation.
              </p>
            </div>
            <span class="text-sm text-[var(--muted)] md:text-right">Emerald Mini Depot Corporation</span>
          </div>
          <div class="grid gap-3 border-b rule py-6 md:grid-cols-[7rem_1fr_15rem] md:gap-8">
            <span class="text-sm text-[var(--muted)]">Aug 4 2025 — May 29 2026</span>
            <div>
              <h2 class="text-xl font-medium tracking-[-0.04em]">Technical support specialist</h2>
              <p class="mt-2 max-w-lg text-sm leading-relaxed text-[var(--muted)]">
                Worked under Indra Philippines and was assigned to PNB, providing technical support and helping users
                resolve day-to-day technology issues.
              </p>
            </div>
            <span class="text-sm text-[var(--muted)] md:text-right">Indra Philippines / PNB</span>
          </div>
          <div class="grid gap-3 border-b rule py-6 md:grid-cols-[7rem_1fr_15rem] md:gap-8">
            <span class="text-sm text-[var(--muted)]">Feb — May 2025</span>
            <div>
              <h2 class="text-xl font-medium tracking-[-0.04em]">IT staff intern</h2>
              <p class="mt-2 max-w-lg text-sm leading-relaxed text-[var(--muted)]">
                Supported day-to-day information technology operations and gained practical experience in workplace
                systems and technical support.
              </p>
            </div>
            <span class="text-sm text-[var(--muted)] md:text-right">DENR-CENRO Ormoc</span>
          </div>
          <div class="grid gap-3 border-b rule py-6 md:grid-cols-[7rem_1fr_15rem] md:gap-8">
            <span class="text-sm text-[var(--muted)]">Ongoing</span>
            <div>
              <h2 class="text-xl font-medium tracking-[-0.04em]">Web + mobile development</h2>
              <p class="mt-2 max-w-lg text-sm leading-relaxed text-[var(--muted)]">
                Continuing to grow through real projects in PHP, Laravel, React, Astro, Flutter, MySQL, and Supabase.
              </p>
            </div>
            <span class="text-sm text-[var(--muted)] md:text-right">Philippines</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="education" class="container-shell border-t rule py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <SectionLabel index="02" label="Education" />
      <div>
        <p class="eyebrow mb-5">Academic foundation</p>
        <h2 class="max-w-3xl text-[clamp(2rem,4.5vw,4.8rem)] font-medium leading-[0.92] tracking-[-0.08em]">
          Bachelor of Science in Information Technology
        </h2>
        <p class="mt-5 text-lg text-[var(--muted)]">
          Eastern Visayas State University — Ormoc Campus
          <span class="mt-2 block text-sm font-semibold uppercase tracking-[0.12em]">2021 — 2025</span>
        </p>
      </div>
    </div>
  </section>

  <section class="container-shell section-space">
    <div class="grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <SectionLabel index="03" label="Working process" />
      <div class="grid gap-0 border-t rule sm:grid-cols-2">
        <div class="border-b rule py-6 sm:border-r sm:pr-8">
          <span class="text-sm text-[var(--muted)]">01</span>
          <h2 class="mt-8 text-2xl font-medium tracking-[-0.05em]">Understand the workflow</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">
            I start with the users, the business process, and the problem the software needs to solve.
          </p>
        </div>
        <div class="border-b rule py-6 sm:pl-8">
          <span class="text-sm text-[var(--muted)]">02</span>
          <h2 class="mt-8 text-2xl font-medium tracking-[-0.05em]">Plan the system</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">
            I map the screens, data, integrations, and edge cases before writing the core features.
          </p>
        </div>
        <div class="border-b rule py-6 sm:border-r sm:pr-8">
          <span class="text-sm text-[var(--muted)]">03</span>
          <h2 class="mt-8 text-2xl font-medium tracking-[-0.05em]">Build the product</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">
            I build the frontend, backend, database, and mobile pieces with responsive behavior and maintainability in
            mind.
          </p>
        </div>
        <div class="border-b rule py-6 sm:pl-8">
          <span class="text-sm text-[var(--muted)]">04</span>
          <h2 class="mt-8 text-2xl font-medium tracking-[-0.05em]">Ship and support</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--muted)]">
            The goal is a useful product that can be tested, improved, and supported after launch.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell border-t rule py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <SectionLabel index="04" label="GitHub activity" />
      <GithubContributions />
    </div>
  </section>

  <section class="container-shell pb-24 md:pb-40">
    <div class="flex flex-col gap-6 border-t rule pt-8 md:flex-row md:items-center md:justify-between">
      <p class="max-w-xl text-2xl font-medium leading-tight tracking-[-0.05em]">
        If you’re building a web or mobile product, we’ll probably get along.
      </p>
      <a class="button-primary" href={sitePath('/contact')}>Say hello <IconArrow /></a>
    </div>
  </section>
</Layout>
