---
import IconArrow from '../components/IconArrow.astro';
import FeaturedProjectShowcase from '../components/FeaturedProjectShowcase.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SocialIcon from '../components/SocialIcon.astro';
import Layout from '../layouts/Layout.astro';
import { featuredProjects } from '../data/projects';
---

<Layout
  description="Jandy Arpon is a full-stack web developer and Flutter mobile app developer based in the Philippines."
>
  <section class="container-shell home-hero pt-20 md:pt-32 lg:pt-40">
    <span class="home-hero__cursor-dot" aria-hidden="true"></span>
    <div class="home-hero__identity mb-14 flex items-center gap-4 md:mb-20">
      <div
        class="h-24 w-24 shrink-0 overflow-hidden rounded-[1.25rem] border rule bg-[var(--background-raised)] md:h-64 md:w-64"
      >
        <img
          src="/me.png"
          alt="Portrait of Jandy Arpon"
          loading="eager"
          decoding="async"
          width="320"
          height="336"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-xl font-semibold leading-none tracking-[-0.06em] md:text-7xl">Jandy Arpon</p>
        <p class="mt-3 max-w-full text-sm text-[var(--muted)] md:text-lg">
          Full-stack web developer + Flutter mobile app developer
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <span class="contact-availability">Available for useful work</span>
          <span class="font-mono text-[0.58rem] uppercase tracking-[0.08em] text-[var(--muted)]">PH / GMT+8</span>
          <div class="flex items-center gap-1 border-l border-[var(--line)] pl-3" aria-label="Social links">
            <a
              class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-[var(--line)] text-[var(--muted)] transition-colors hover:border-[var(--accent)] hover:bg-[var(--accent)] hover:text-[#020202]"
              href="mailto:jansnww@gmail.com"
              aria-label="Email Jandy Arpon"
              title="Email"
            >
              <SocialIcon platform="email" className="h-3.5 w-3.5" />
            </a>
            <a
              class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-[var(--line)] text-[var(--muted)] transition-colors hover:border-[var(--accent)] hover:bg-[var(--accent)] hover:text-[#020202]"
              href="https://github.com/jandgwapo"
              target="_blank"
              rel="noreferrer"
              aria-label="Visit Jandy Arpon on GitHub"
              title="GitHub"
            >
              <SocialIcon platform="github" className="h-3.5 w-3.5" />
            </a>
            <a
              class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-[var(--line)] text-[var(--muted)] transition-colors hover:border-[var(--accent)] hover:bg-[var(--accent)] hover:text-[#020202]"
              href="https://www.instagram.com/_jansnoww/"
              target="_blank"
              rel="noreferrer"
              aria-label="Visit Jandy Arpon on Instagram"
              title="Instagram"
            >
              <SocialIcon platform="instagram" className="h-3.5 w-3.5" />
            </a>
            <a
              class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-[var(--line)] text-[var(--muted)] transition-colors hover:border-[var(--accent)] hover:bg-[var(--accent)] hover:text-[#020202]"
              href="https://www.linkedin.com/in/jandy-arpon-670b833b7"
              target="_blank"
              rel="noreferrer"
              aria-label="Visit Jandy Arpon on LinkedIn"
              title="LinkedIn"
            >
              <SocialIcon platform="linkedin" className="h-3.5 w-3.5" />
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="grid gap-12 md:grid-cols-[minmax(0,1fr)_18rem] md:items-end lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div>
        <p class="eyebrow mb-7">Full-stack web + mobile app developer</p>
        <h1 class="display max-w-6xl">
          I build digital products<br />
          <span class="display-serif">with purpose.</span>
        </h1>
      </div>
      <div class="border-t rule pt-6 md:mb-2 md:border-l md:border-t-0 md:pl-6 md:pt-0">
        <p class="text-lg leading-snug tracking-[-0.025em]">
          I’m Jandy Arpon — a full-stack web developer and Flutter mobile app developer building practical tools for
          teams, businesses, and communities.
        </p>
        <p class="mt-5 text-sm leading-relaxed text-[var(--muted)]">
          Currently a full-stack web developer at Emerald Mini Depot Corporation, working across interfaces, systems,
          and data.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="button-primary" href="#about">About me <IconArrow /></a>
          <a class="button-secondary" href="/projects">View projects <IconArrow /></a>
        </div>
      </div>
    </div>
    <div
      class="mt-20 flex flex-wrap items-center justify-between gap-3 border-y rule py-4 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[var(--muted)] md:mt-28"
    >
      <span>Based in the Philippines</span>
      <span class="hidden sm:block">Web / mobile / full-stack</span>
      <a class="transition-colors hover:text-[var(--foreground)]" href="#about">Scroll to learn more ↓</a>
    </div>
    <div class="home-hero__signals" aria-label="Portfolio at a glance">
      <div class="home-hero__signal">
        <strong>03</strong>
        <span>Selected projects</span>
      </div>
      <div class="home-hero__signal">
        <strong>15</strong>
        <span>Core tools</span>
      </div>
      <div class="home-hero__signal">
        <strong>PH</strong>
        <span>Based in the Philippines</span>
      </div>
    </div>
  </section>

  <section id="about" class="container-shell section-space">
    <div class="grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <SectionLabel index="01" label="About Jandy" />
      <div>
        <h2 class="max-w-4xl text-[clamp(2.8rem,6vw,6.4rem)] font-medium leading-[0.9] tracking-[-0.09em]">
          Good software lives between <span class="display-serif">clarity</span> and care.
        </h2>
        <div class="mt-8 max-w-3xl space-y-5 text-lg leading-relaxed text-[var(--muted)]">
          <p>
            I enjoy turning real needs into clear interfaces, reliable systems, and mobile experiences that people can
            use without friction.
          </p>
          <p>
            My work spans frontend, backend, databases, and technical support. That mix helps me understand both the
            product people see and the systems that keep it working.
          </p>
        </div>
        <a
          class="group mt-8 inline-flex items-center gap-2 border-b border-[var(--foreground)] pb-2 text-sm font-semibold"
          href="/about">More about how I work <IconArrow /></a
        >
      </div>
    </div>
  </section>

  <section id="experience" class="container-shell section-space">
    <div class="grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <SectionLabel index="02" label="Experience" />
      <div>
        <p class="mb-8 max-w-xl text-lg leading-relaxed text-[var(--muted)]">
          A practical path from information technology support to building full-stack web products.
        </p>
        <div class="border-t rule">
          <div class="grid gap-3 border-b rule py-6 md:grid-cols-[8rem_1fr_15rem] md:gap-8">
            <span class="text-sm text-[var(--muted)]">May 30, 2026 — present</span>
            <div>
              <h2 class="text-xl font-medium tracking-[-0.04em]">Full-stack web developer</h2>
              <p class="mt-2 max-w-lg text-sm leading-relaxed text-[var(--muted)]">
                Building and maintaining web applications, internal workflows, responsive interfaces, and data-driven
                tools.
              </p>
            </div>
            <span class="text-sm text-[var(--muted)] md:text-right">Emerald Mini Depot Corporation</span>
          </div>
          <div class="grid gap-3 border-b rule py-6 md:grid-cols-[8rem_1fr_15rem] md:gap-8">
            <span class="text-sm text-[var(--muted)]">Aug 4, 2025 — May 29, 2026</span>
            <div>
              <h2 class="text-xl font-medium tracking-[-0.04em]">Technical support</h2>
              <p class="mt-2 max-w-lg text-sm leading-relaxed text-[var(--muted)]">
                Worked under Indra Philippines and was assigned to PNB, helping users resolve day-to-day technology
                issues.
              </p>
            </div>
            <span class="text-sm text-[var(--muted)] md:text-right">Indra Philippines / PNB</span>
          </div>
          <div class="grid gap-3 border-b rule py-6 md:grid-cols-[8rem_1fr_15rem] md:gap-8">
            <span class="text-sm text-[var(--muted)]">Feb — May 2025</span>
            <div>
              <h2 class="text-xl font-medium tracking-[-0.04em]">IT staff intern</h2>
              <p class="mt-2 max-w-lg text-sm leading-relaxed text-[var(--muted)]">
                Supported day-to-day information technology operations at DENR-CENRO Ormoc.
              </p>
            </div>
            <span class="text-sm text-[var(--muted)] md:text-right">DENR-CENRO Ormoc</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="education" class="container-shell border-t rule py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <SectionLabel index="03" label="Education" />
      <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr] md:gap-12">
        <div>
          <p class="eyebrow mb-5">Academic foundation</p>
          <h2 class="max-w-2xl text-[clamp(2rem,4.5vw,4.8rem)] font-medium leading-[0.92] tracking-[-0.08em]">
            Bachelor of Science in Information Technology
          </h2>
          <p class="mt-5 text-lg text-[var(--muted)]">
            Eastern Visayas State University — Ormoc Campus
            <span class="mt-2 block text-sm font-semibold uppercase tracking-[0.12em]">2021 — 2025</span>
          </p>
        </div>
        <div class="border-t rule pt-5 md:border-l md:border-t-0 md:pl-8 md:pt-0">
          <p class="text-sm leading-relaxed text-[var(--muted)]">
            My BSIT background supports the way I approach software: understand the system, respect the data, and keep
            the experience useful for the people who depend on it.
          </p>
          <a
            class="group mt-6 inline-flex items-center gap-2 border-b border-[var(--foreground)] pb-2 text-sm font-semibold"
            href="/about"
          >
            Read my process <IconArrow />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="container-shell section-space">
    <div class="mb-10 flex items-end justify-between gap-6 md:mb-14">
      <div>
        <SectionLabel index="04" label="Selected work" />
        <h2 class="mt-5 max-w-xl text-[clamp(2.5rem,5vw,5.5rem)] font-medium leading-[0.92] tracking-[-0.09em]">
          Projects built for real use.
        </h2>
      </div>
      <a class="group hidden items-center gap-2 pb-1 text-sm font-semibold md:flex" href="/projects"
        >See all projects <IconArrow /></a
      >
    </div>
    <div>
      {
        featuredProjects.map((project, index) => (
          <FeaturedProjectShowcase project={project} reverse={index % 2 === 1} />
        ))
      }
    </div>
    <a class="button-secondary mt-10 md:hidden" href="/projects">See all projects <IconArrow /></a>
  </section>

  <section id="skills" class="container-shell border-t rule py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-[0.8fr_1.4fr] md:gap-20">
      <div>
        <SectionLabel index="05" label="What I bring" />
      </div>
      <div>
        <p class="max-w-4xl text-[clamp(2rem,4.6vw,5rem)] font-medium leading-[0.98] tracking-[-0.085em]">
          Practical full-stack systems with a <span class="text-[var(--muted)]">clean frontend</span>, a reliable
          backend, and a mobile experience when the workflow needs one.
        </p>
        <div class="mt-14 grid border-t rule sm:grid-cols-2">
          <div class="border-b rule py-5 sm:border-r sm:pr-7">
            <p class="mb-3 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[var(--muted)]">Frontend</p>
            <p class="text-lg tracking-[-0.025em]">
              Responsive interfaces with Tailwind CSS, React, Astro, accessible UI, and a focus on making workflows easy
              to use.
            </p>
          </div>
          <div class="border-b rule py-5 sm:pl-7">
            <p class="mb-3 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[var(--muted)]">
              Backend + mobile
            </p>
            <p class="text-lg tracking-[-0.025em]">
              Laravel and PHP applications, MySQL and Supabase data, plus Flutter apps that connect to real business
              needs.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="container-shell pb-24 md:pb-40">
    <div class="surface-card relative overflow-hidden px-6 py-12 md:px-16 md:py-20">
      <div
        class="absolute -right-12 -top-20 h-64 w-64 rounded-full border-[30px] border-[var(--accent)] opacity-80 md:-right-20 md:-top-28 md:h-96 md:w-96"
      >
      </div>
      <div class="relative max-w-3xl">
        <SectionLabel index="06" label="Let’s connect" />
        <h2 class="mt-6 text-[clamp(3rem,7vw,7.8rem)] font-medium leading-[0.86] tracking-[-0.1em]">
          Have a good<br /><span class="display-serif">question?</span>
        </h2>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-[var(--muted)]">
          Tell me what you’re trying to build, improve, or move from idea to launch. I’d love to hear about it.
        </p>
        <a class="button-primary mt-8" href="/contact">Let’s talk <IconArrow /></a>
      </div>
    </div>
  </section>
</Layout>
