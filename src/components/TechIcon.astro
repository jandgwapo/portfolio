const mark = brand ? officialMarks[brand] : icon;
---

{
  mark ? (
    <svg
      class:list={[className, brand === 'codex' && 'tech-icon--codex']}
      viewBox="0 0 24 24"
      fill={brand === 'codex' ? 'currentColor' : '#' + mark.hex}
      role="img"
      aria-label={mark.title}
    >
      <path d={mark.path}></path>
    </svg>
  ) : null
}
