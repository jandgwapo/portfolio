---
interface Props {
  src: string;
  alt: string;
  className?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, className = '', loading = 'lazy' } = Astro.props;
const params = 'auto=format&fit=crop&w=1600&q=82';
const avif = `${src}?${params}&fm=avif`;
const webp = `${src}?${params}&fm=webp`;
const fallback = `${src}?${params}`;
---

<picture class={`project-image block ${className}`}>
  <source srcset={avif} type="image/avif" />
  <source srcset={webp} type="image/webp" />
  <img src={fallback} alt={alt} loading={loading} decoding="async" width="1600" height="1200" />
</picture>
