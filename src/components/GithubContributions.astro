---
import IconArrow from './IconArrow.astro';

type ContributionCell = {
  day: number;
  week: number;
  date: string;
  level: number;
  count: number;
  label: string;
};

const username = 'jandgwapo';
const profileUrl = `https://github.com/${username}`;
let contributionCells: ContributionCell[] = [];
let contributionTotal = 0;
let isLive = false;

const stripTags = (value: string) => value.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();

try {
  const response = await fetch(`https://github.com/users/${username}/contributions`);

  if (!response.ok) {
    throw new Error(`GitHub returned ${response.status}`);
  }

  const html = await response.text();
  const totalMatch = html.match(
    /<h2[^>]*id="js-contribution-activity-description"[^>]*>([\s\S]*?)<\/h2>/,
  );
  const totalText = totalMatch ? stripTags(totalMatch[1]) : '';
  const parsedTotal = totalText.match(/([\d,]+)\s+contributions?/i);

  if (parsedTotal) {
    contributionTotal = Number(parsedTotal[1].replace(/,/g, ''));
  }

  const cellPattern =
    /<td(?=[^>]*id="contribution-day-component-(\d+)-(\d+)")(?=[^>]*data-date="([^"]+)")(?=[^>]*data-level="(\d+)")[^>]*>[\s\S]*?<tool-tip[^>]*>([\s\S]*?)<\/tool-tip>/g;

  for (const match of html.matchAll(cellPattern)) {
    const label = stripTags(match[5]);
    const parsedCount = label.match(/(\d[\d,]*)\s+contributions?/i);

    contributionCells.push({
      day: Number(match[1]),
      week: Number(match[2]),
      date: match[3],
      level: Number(match[4]),
      count: parsedCount ? Number(parsedCount[1].replace(/,/g, '')) : 0,
      label,
    });
  }

  if (contributionCells.length > 0) {
    isLive = true;
  }
} catch {
  // Keep the section renderable if GitHub is unavailable during the build.
}

if (contributionTotal === 0 && contributionCells.length > 0) {
  contributionTotal = contributionCells.reduce((total, cell) => total + cell.count, 0);
}

const maxWeek = contributionCells.reduce((latest, cell) => Math.max(latest, cell.week), 51);
const weekCount = maxWeek + 1;
const weeks = Array.from({ length: weekCount }, (_, week) =>
  Array.from({ length: 7 }, (_, day) => contributionCells.find((cell) => cell.week === week && cell.day === day) ?? null),
);
const activeDays = contributionCells.filter((cell) => cell.count > 0).length;
const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'long' });
const shortMonthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short' });
const monthLabels = weeks.reduce<{ label: string; shortLabel: string; index: number }[]>((labels, week, index) => {
  const firstCell = week.find((cell) => cell !== null);

  if (!firstCell) {
    return labels;
  }

  const date = new Date(`${firstCell.date}T12:00:00Z`);
  const label = monthFormatter.format(date);

  if (labels.at(-1)?.label !== label) {
    labels.push({ label, shortLabel: shortMonthFormatter.format(date), index });
  }

  return labels;
}, []);
const monthLabelsWithSpan = monthLabels.map((month, index) => ({
  ...month,
  span: (monthLabels[index + 1]?.index ?? weekCount) - month.index,
}));
---

<div class="github-activity" aria-labelledby="github-activity-title">
  <div class="github-activity__intro">
    <div>
      <p class="eyebrow">github / {username}</p>
      <h2 id="github-activity-title" class="mt-5 max-w-3xl text-[clamp(2.25rem,5vw,5.4rem)] font-medium leading-[0.9] tracking-[-0.08em]">
        Code, in <span class="display-serif">motion.</span>
      </h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--muted)]">
        A year of commits, reviews, and small improvements—mapped one day at a time.
      </p>
    </div>
    <a class="button-secondary github-activity__profile" href={profileUrl} target="_blank" rel="noreferrer">
      View on GitHub <IconArrow />
    </a>
  </div>

  <div class="github-activity__panel surface-card">
    <div class="github-activity__panel-header">
      <div>
        <p class="eyebrow">Contribution graph</p>
        <p class="mt-3 text-sm text-[var(--muted)]">The last 12 months</p>
      </div>
      <span class="github-activity__status">
        <span class="github-activity__status-dot" aria-hidden="true"></span>
        {isLive ? 'GitHub snapshot' : 'GitHub unavailable'}
      </span>
    </div>

    <div class="github-activity__stats" aria-label="GitHub contribution summary">
      <div class="github-activity__stat">
        <strong>{contributionTotal.toLocaleString()}</strong>
        <span>contributions</span>
      </div>
      <div class="github-activity__stat">
        <strong>{activeDays}</strong>
        <span>active days</span>
      </div>
      <div class="github-activity__stat">
        <strong>{isLive ? weekCount : '—'}</strong>
        <span>weeks tracked</span>
      </div>
    </div>

    <div class="github-calendar__scroll">
      <div
        class="github-calendar"
        style={`--github-columns: ${weekCount}; --github-grid-columns: ${weekCount + 1}`}
        role="grid"
        aria-label="GitHub contributions for the last 12 months"
      >
        <span class="github-calendar__axis">Day of Week</span>
        {monthLabelsWithSpan
          .filter(({ span, index }) => span > 1 || index > 0)
          .map(({ label, shortLabel, index, span }) => (
            <span
              class="github-month"
              style={`grid-column: ${index + 2} / span ${span}; grid-row: 1`}
              title={label}
            >
              <span class="github-month__full sr-only">{label}</span>
              <span class="github-month__short">{shortLabel}</span>
            </span>
          ))}
        {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((day, index) => (
          <span class="github-day-label" style={`grid-column: 1; grid-row: ${index + 2}`}>{day}</span>
        ))}
        {weeks.map((week, weekIndex) =>
          week.map((cell, dayIndex) => {
            const cellStyle = `grid-column: ${weekIndex + 2}; grid-row: ${dayIndex + 2}`;

            return cell ? (
              <span
                class:list={['github-cell', `github-cell--level-${cell.level}`]}
                style={cellStyle}
                role="gridcell"
                title={cell.label}
                aria-label={cell.label}
              ></span>
            ) : (
              <span class="github-cell github-cell--level-0" style={cellStyle} aria-hidden="true"></span>
            );
          }),
        )}
      </div>
    </div>

    <div class="github-activity__footer">
      <span class="github-activity__unit">1 box = 1 day</span>
      <div class="github-activity__legend" aria-label="Contribution intensity legend">
        <span>Less</span>
        <span class="github-legend-cell github-cell--level-0" aria-hidden="true"></span>
        <span class="github-legend-cell github-cell--level-1" aria-hidden="true"></span>
        <span class="github-legend-cell github-cell--level-2" aria-hidden="true"></span>
        <span class="github-legend-cell github-cell--level-3" aria-hidden="true"></span>
        <span class="github-legend-cell github-cell--level-4" aria-hidden="true"></span>
        <span>More</span>
      </div>
    </div>
  </div>
</div>

<style>
  .github-activity {
    min-width: 0;
  }

  :global(.github-activity-section) {
    width: min(100% - 5rem, 1680px);
  }

  .github-activity__intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  .github-activity__profile {
    flex-shrink: 0;
  }

  .github-activity__panel {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    overflow: hidden;
  }

  .github-activity__panel-header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .github-activity__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .github-activity__status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--accent-deep);
    box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .github-activity__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }

  .github-activity__stat {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.25rem;
    border-right: 1px solid var(--line);
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .github-activity__stat:last-child {
    border-right: 0;
  }

  .github-activity__stat strong {
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -0.08em;
    line-height: 0.9;
  }

  .github-activity__stat span {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .github-calendar__scroll {
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .github-calendar {
    --github-cell-size: clamp(0.3rem, 0.62vw, 0.62rem);
    --github-cell-gap: clamp(0.12rem, 0.18vw, 0.18rem);
    display: grid;
    grid-template-columns: 3.25rem repeat(var(--github-columns), var(--github-cell-size));
    grid-template-rows: 1.15rem repeat(7, var(--github-cell-size));
    width: max-content;
    min-width: 100%;
    gap: var(--github-cell-gap);
    justify-content: start;
  }

  .github-calendar__axis,
  .github-day-label,
  .github-month {
    min-width: 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.58rem;
    line-height: 1;
    white-space: nowrap;
  }

  .github-calendar__axis {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    color: var(--foreground);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .github-day-label {
    align-self: center;
  }

  .github-month {
    display: block;
    align-self: center;
    text-align: left;
  }

  .github-month__full {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .github-month__short {
    display: block;
  }

  .github-cell {
    display: block;
    width: var(--github-cell-size);
    height: var(--github-cell-size);
    min-width: 0;
    border: 1px solid transparent;
    border-radius: 2px;
    transition:
      transform 160ms ease,
      border-color 160ms ease;
  }

  .github-cell:hover {
    border-color: var(--foreground);
    transform: scale(1.35);
  }

  .github-cell--level-0 {
    background: color-mix(in srgb, var(--foreground) 8%, var(--background-raised));
  }

  .github-cell--level-1 {
    background: color-mix(in srgb, var(--accent) 30%, var(--background-raised));
  }

  .github-cell--level-2 {
    background: color-mix(in srgb, var(--accent) 52%, var(--background-raised));
  }

  .github-cell--level-3 {
    background: color-mix(in srgb, var(--accent) 75%, var(--background-raised));
  }

  .github-cell--level-4 {
    background: var(--accent);
  }

  .github-activity__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding: 1rem clamp(1.25rem, 3vw, 2rem);
    color: var(--muted);
    font-size: 0.68rem;
  }

  .github-activity__unit {
    font-size: 0.68rem;
  }

  .github-activity__legend {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .github-legend-cell {
    width: 0.46rem;
    height: 0.46rem;
    flex: 0 0 0.46rem;
    border-radius: 1px;
  }

  @media (max-width: 767px) {
    :global(.github-activity-section) {
      width: min(100% - 2rem, 1680px);
    }

    .github-activity__intro {
      align-items: start;
      flex-direction: column;
    }

    .github-activity__panel-header {
      flex-direction: column;
    }

    .github-activity__status {
      align-self: start;
    }

    .github-calendar {
      --github-cell-size: clamp(0.18rem, 1vw, 0.42rem);
      --github-cell-gap: clamp(0.04rem, 0.14vw, 0.14rem);
      grid-template-columns: 2.25rem repeat(var(--github-columns), var(--github-cell-size));
      grid-template-rows: 1rem repeat(7, var(--github-cell-size));
    }

    .github-calendar__axis,
    .github-day-label,
    .github-month {
      font-size: 0.5rem;
    }
  }

  @media (max-width: 420px) {
    .github-activity__stats {
      grid-template-columns: 1fr;
    }

    .github-activity__stat {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .github-activity__stat:last-child {
      border-bottom: 0;
    }

    .github-activity__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
