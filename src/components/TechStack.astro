---
import {
  siAstro,
  siComposer,
  siFlutter,
  siGit,
  siGsap,
  siLaragon,
  siLaravel,
  siMysql,
  siNodedotjs,
  siPhp,
  siReact,
  siSupabase,
  siTailwindcss,
} from 'simple-icons';
import type { SimpleIcon } from 'simple-icons';
import TechIcon from './TechIcon.astro';

type Technology = {
  name: string;
  icon?: SimpleIcon;
  brand?: 'vscode' | 'codex';
  detail: string;
  why: string;
  strengths: string[];
};

type TechnologyGroup = {
  label: string;
  description: string;
  items: Technology[];
};

const groups: TechnologyGroup[] = [
  {
    label: 'Frontend',
    description: 'Interfaces, responsive experiences, and mobile products.',
    items: [
      {
        name: 'Flutter',
        icon: siFlutter,
        detail: 'Mobile apps',
        why: 'A single codebase lets me ship polished Android and iOS experiences faster while keeping the interface consistent.',
        strengths: ['Shared codebase', 'Native-feeling UI', 'Fast mobile iteration'],
      },
      {
        name: 'React',
        icon: siReact,
        detail: 'Frontend UI',
        why: 'Reusable components make complex interfaces easier to scale, test, and keep visually consistent.',
        strengths: ['Reusable components', 'Scalable UI patterns', 'Strong ecosystem'],
      },
      {
        name: 'Astro',
        icon: siAstro,
        detail: 'Websites',
        why: 'It keeps content-first websites fast by sending minimal JavaScript while still allowing interactive islands when needed.',
        strengths: ['Fast page loads', 'Minimal JavaScript', 'Flexible interactivity'],
      },
      {
        name: 'Tailwind CSS',
        icon: siTailwindcss,
        detail: 'UI styling',
        why: 'A shared utility language helps me build responsive layouts quickly without a growing collection of one-off CSS rules.',
        strengths: ['Responsive by default', 'Consistent spacing', 'Fast visual iteration'],
      },
      {
        name: 'GSAP',
        icon: siGsap,
        detail: 'Web animation',
        why: 'Precise timelines and performant motion help interfaces feel intentional without getting in the way of the task.',
        strengths: ['Precise timelines', 'Smooth performance', 'Rich interaction control'],
      },
    ],
  },
  {
    label: 'Backend',
    description: 'Applications, data, APIs, and services behind the interface.',
    items: [
      {
        name: 'PHP',
        icon: siPhp,
        detail: 'Web development',
        why: 'A mature ecosystem and broad hosting support make it a dependable choice for practical business applications.',
        strengths: ['Mature ecosystem', 'Broad hosting support', 'Practical deployment options'],
      },
      {
        name: 'Laravel',
        icon: siLaravel,
        detail: 'Backend framework',
        why: 'It provides clear structure for routing, validation, authentication, queues, and database work so features stay maintainable.',
        strengths: ['Clear project structure', 'Built-in conventions', 'Fast feature delivery'],
      },
      {
        name: 'Node.js',
        icon: siNodedotjs,
        detail: 'JavaScript runtime',
        why: 'Using JavaScript on the server is useful for APIs, real-time features, and projects that share language across the stack.',
        strengths: ['Shared JavaScript stack', 'Real-time capabilities', 'Large package ecosystem'],
      },
      {
        name: 'MySQL',
        icon: siMysql,
        detail: 'Database',
        why: 'Reliable relational data, constraints, and proven tooling make it a strong foundation for business workflows.',
        strengths: ['Reliable relationships', 'Strong data integrity', 'Proven tooling'],
      },
      {
        name: 'Supabase',
        icon: siSupabase,
        detail: 'Backend services',
        why: 'Managed Postgres, authentication, storage, and real-time features help me launch useful products with less infrastructure overhead.',
        strengths: ['Managed Postgres', 'Built-in authentication', 'Realtime and storage'],
      },
    ],
  },
  {
    label: 'Workflow',
    description: 'Tools that keep building, testing, and shipping organized.',
    items: [
      {
        name: 'Git',
        icon: siGit,
        detail: 'Version control',
        why: 'A clear history makes experimentation safer and gives every feature, fix, and release an understandable trail.',
        strengths: ['Safe experimentation', 'Readable history', 'Team collaboration'],
      },
      {
        name: 'Composer',
        icon: siComposer,
        detail: 'PHP dependencies',
        why: 'It keeps PHP packages versioned and reproducible so projects are easier to install, share, and maintain.',
        strengths: ['Reproducible installs', 'Dependency versioning', 'Simple project setup'],
      },
      {
        name: 'Codex',
        brand: 'codex',
        detail: 'AI assistance',
        why: 'It helps me explore a codebase, reason through alternatives, and move repetitive implementation work forward while I review the result.',
        strengths: ['Codebase exploration', 'Faster iteration', 'Human-reviewed output'],
      },
      {
        name: 'VS Code',
        brand: 'vscode',
        detail: 'IDE',
        why: 'Extensions, debugging, source control, and a focused editor keep the full build-and-test loop close at hand.',
        strengths: ['Powerful extensions', 'Integrated debugging', 'Focused workflow'],
      },
      {
        name: 'Laragon',
        icon: siLaragon,
        detail: 'Local development',
        why: 'A lightweight local PHP environment makes it quick to run, test, and switch between projects before deployment.',
        strengths: ['Quick local setup', 'Easy PHP switching', 'Fast project testing'],
      },
    ],
  },
];
---

<div class="tech-stack-groups">
  {
    groups.map((group, groupIndex) => (
      <section class="tech-stack-group" aria-labelledby={'tech-stack-' + group.label.toLowerCase()}>
        <div class="tech-stack-group__header">
          <div>
            <p class="eyebrow" id={'tech-stack-' + group.label.toLowerCase()}>{group.label}</p>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-[var(--muted)]">{group.description}</p>
          </div>
          <span class="font-mono text-[0.55rem] uppercase tracking-[0.08em] text-[var(--muted)]">
            {group.items.length.toString().padStart(2, '0')} tools
          </span>
        </div>
        <div class:list={['stack-browser', groupIndex % 2 === 1 && 'stack-browser--reverse']} data-stack-browser>
          <div class="tech-stack tech-stack--detailed grid gap-3 sm:grid-cols-2">
            {
              group.items.map((technology) => (
                <div class="tech-stack__item surface-card transition-transform hover:-translate-y-1">
                  <button
                    class="tech-stack__trigger"
                    type="button"
                    aria-pressed="false"
                    aria-controls={'stack-panel-' + group.label.toLowerCase() + '-' + technology.name.toLowerCase().replaceAll(' ', '-')}
                    data-stack-trigger
                  >
                    <span
                      class:list={[
                        'tech-stack__icon',
                        'flex h-10 w-10 shrink-0 items-center justify-center rounded-full',
                        (technology.brand || technology.name === 'Composer') && 'tech-stack__icon--brand',
                      ]}
                    >
                      <TechIcon icon={technology.icon} brand={technology.brand} />
                    </span>
                    <span class="tech-stack__text">
                      <span class="block text-sm font-semibold">{technology.name}</span>
                      <span class="mt-1 block text-xs text-[var(--muted)]">{technology.detail}</span>
                    </span>
                    <span class="tech-stack__toggle" aria-hidden="true">→</span>
                  </button>
                </div>
              ))
            }
          </div>

          <div class="stack-detail-stage" aria-live="polite">
            <div class="stack-detail-panel stack-detail-panel--placeholder" data-stack-placeholder>
              <span class="stack-detail-panel__label">Explore the stack</span>
              <p class="stack-detail-panel__placeholder-title">Choose a tool to see why it belongs in my workflow.</p>
              <p class="stack-detail-panel__placeholder-copy">
                Each detail includes the practical reason I use it and the strengths it brings to a project.
              </p>
              <span class="stack-detail-panel__cursor" aria-hidden="true">←</span>
            </div>
            {
              group.items.map((technology) => (
                <article
                  class="stack-detail-panel"
                  id={'stack-panel-' + group.label.toLowerCase() + '-' + technology.name.toLowerCase().replaceAll(' ', '-')}
                  data-stack-panel
                  hidden
                >
                  <div class="stack-detail-panel__topline">
                    <span class="stack-detail-panel__label">{group.label} / tool detail</span>
                    <span class="stack-detail-panel__index">{technology.detail}</span>
                  </div>
                  <div class="stack-detail-panel__identity">
                    <span
                      class:list={[
                        'stack-detail-panel__icon',
                        'flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl',
                        (technology.brand || technology.name === 'Composer') && 'tech-stack__icon--brand',
                      ]}
                    >
                      <TechIcon icon={technology.icon} brand={technology.brand} className="h-7 w-7" />
                    </span>
                    <h3 class="stack-detail-panel__title">{technology.name}</h3>
                  </div>
                  <div class="stack-detail-panel__section">
                    <span class="stack-detail-panel__label">Why it belongs</span>
                    <p class="stack-detail-panel__why">{technology.why}</p>
                  </div>
                  <div class="stack-detail-panel__section">
                    <span class="stack-detail-panel__label">Good sides</span>
                    <ul class="stack-detail-panel__strengths">
                      {technology.strengths.map((strength) => <li>{strength}</li>)}
                    </ul>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    ))
  }
</div>

<script>
  const bindStackBrowsers = () => {
    document.querySelectorAll<HTMLElement>('[data-stack-browser]').forEach((browser) => {
      if (browser.dataset.stackBrowserBound === 'true') return;

      browser.dataset.stackBrowserBound = 'true';
      const triggers = Array.from(browser.querySelectorAll<HTMLButtonElement>('[data-stack-trigger]'));
      const panels = Array.from(browser.querySelectorAll<HTMLElement>('[data-stack-panel]'));
      const placeholder = browser.querySelector<HTMLElement>('[data-stack-placeholder]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const panelId = trigger.getAttribute('aria-controls');
          const panel = panelId ? browser.querySelector<HTMLElement>('#' + CSS.escape(panelId)) : null;
          if (!panel) return;
          const isAlreadySelected = trigger.getAttribute('aria-pressed') === 'true';

          triggers.forEach((item) => {
            item.setAttribute('aria-pressed', 'false');
            item.closest('.tech-stack__item')?.classList.remove('is-active');
          });
          panels.forEach((item) => {
            item.hidden = true;
          });

          if (isAlreadySelected) {
            if (placeholder) {
              placeholder.hidden = false;
              if (!reducedMotion) {
                placeholder.animate(
                  [
                    { opacity: 0, transform: 'translateY(8px)' },
                    { opacity: 1, transform: 'translateY(0)' },
                  ],
                  { duration: 260, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
                );
              }
            }
            return;
          }

          trigger.setAttribute('aria-pressed', 'true');
          trigger.closest('.tech-stack__item')?.classList.add('is-active');
          if (placeholder) placeholder.hidden = true;
          panel.hidden = false;

          if (!reducedMotion) {
            panel.animate(
              [
                { opacity: 0, transform: 'translateY(10px)' },
                { opacity: 1, transform: 'translateY(0)' },
              ],
              { duration: 320, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
            );
          }

          if (window.innerWidth < 768) {
            panel.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'nearest' });
          }
        });
      });
    });
  };

  bindStackBrowsers();
  document.addEventListener('astro:page-load', bindStackBrowsers);
</script>
