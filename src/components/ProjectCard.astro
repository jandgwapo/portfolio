---
import ProjectVisual from './ProjectVisual.astro';
import ProjectTools from './ProjectTools.astro';
import type { Project } from '../types';

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const visualClass = compact ? 'aspect-[1.35/1]' : 'aspect-[1.15/1] md:aspect-[1.45/1]';
---

<a class="project-link group block" href={`/projects/${project.slug}`}>
  {
    project.liveUrl ? (
      <div class="project-image live-site-preview relative block aspect-[16/10] w-full">
        <iframe
          src={project.liveUrl}
          title={`${project.title} live homepage preview`}
          loading="lazy"
          referrerpolicy="no-referrer"
          class="pointer-events-none absolute inset-0 block h-full w-full border-0 bg-[var(--background-raised)]"
        />
        <span class="pointer-events-none absolute bottom-3 left-3 bg-[var(--accent)] px-2 py-1 text-[0.6rem] font-bold uppercase tracking-[0.12em] text-[#020202]">
          Live homepage
        </span>
      </div>
    ) : (
      <ProjectVisual src={project.image} alt={project.imageAlt} className={visualClass} />
    )
  }
  <div class="mt-4 flex items-start justify-between gap-5 border-b rule pb-5">
    <div>
      <div
        class="mb-2 flex items-center gap-2 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[var(--muted)]"
      >
        <span>{project.category}</span>
        <span class="h-1 w-1 rounded-full bg-[var(--accent-deep)]"></span>
        <span>{project.year}</span>
      </div>
      <h3 class="text-[clamp(1.4rem,2.4vw,2.3rem)] font-medium tracking-[-0.065em]">{project.title}</h3>
      {!compact && <p class="mt-2 max-w-md text-sm leading-relaxed text-[var(--muted)]">{project.description}</p>}
      {
        !compact && (
          <div class="mt-4">
            <ProjectTools tools={project.tools} compact />
          </div>
        )
      }
    </div>
    <span
      class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border rule text-lg transition-colors group-hover:border-[var(--accent)] group-hover:bg-[var(--accent)] group-hover:text-[#020202]"
      aria-hidden="true">↗</span
    >
  </div>
</a>
