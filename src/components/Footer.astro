---
import SocialIcon from './SocialIcon.astro';
import { sitePath } from '../utils/site-path';
---

<footer class="container-shell site-footer border-t rule py-8 md:py-10">
  <div class="site-footer__top">
    <div class="max-w-xl">
      <p class="footer-kicker mb-4">Independent developer / Philippines</p>
      <h2 class="text-[clamp(2rem,4vw,4.5rem)] font-medium leading-[0.92] tracking-[-0.08em]">
        Let’s make something <span class="display-serif">useful.</span>
      </h2>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-[var(--muted)]">
        Full-stack web and mobile app development for practical products, teams, and communities.
      </p>
    </div>

    <div class="site-footer__side">
      <nav class="site-footer__nav" aria-label="Footer navigation">
        <a href={sitePath('/')}><span class="site-footer__nav-index">01</span><span>Home</span></a>
        <a href={sitePath('/about')}><span class="site-footer__nav-index">02</span><span>About</span></a>
        <a href={sitePath('/stack')}><span class="site-footer__nav-index">03</span><span>Stack</span></a>
        <a href={sitePath('/projects')}><span class="site-footer__nav-index">04</span><span>Projects</span></a>
        <a href={sitePath('/gear')}><span class="site-footer__nav-index">05</span><span>Gear</span></a>
        <a href={sitePath('/contact')}><span class="site-footer__nav-index">06</span><span>Contact</span></a>
      </nav>

      <div class="flex flex-wrap items-center gap-2 text-[0.75rem] font-semibold text-[var(--muted)]">
        <a
          class="site-footer__social-link inline-flex h-9 w-9 items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-deep)]"
          href="mailto:jansnww@gmail.com"
          aria-label="Email Jandy Arpon"
          title="Email Jandy Arpon"
        >
          <SocialIcon platform="email" />
        </a>
        <a
          class="site-footer__social-link inline-flex h-9 w-9 items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-deep)]"
          href="https://github.com/jandgwapo"
          target="_blank"
          rel="noreferrer"
          aria-label="Visit Jandy Arpon on GitHub"
          title="GitHub"
        >
          <SocialIcon platform="github" />
        </a>
        <a
          class="site-footer__social-link inline-flex h-9 w-9 items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-deep)]"
          href="https://www.linkedin.com/in/jandy-arpon-670b833b7"
          target="_blank"
          rel="noreferrer"
          aria-label="Visit Jandy Arpon on LinkedIn"
          title="LinkedIn"
        >
          <SocialIcon platform="linkedin" />
        </a>
        <a
          class="site-footer__social-link inline-flex h-9 w-9 items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-deep)]"
          href="https://www.instagram.com/_jansnoww/"
          target="_blank"
          rel="noreferrer"
          aria-label="Visit Jandy Arpon on Instagram"
          title="Instagram"
        >
          <SocialIcon platform="instagram" />
        </a>
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <span>© {new Date().getFullYear()} Jandy Arpon</span>
    <span>Web / mobile / full-stack</span>
    <a href="#main-content">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>
