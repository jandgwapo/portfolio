---
import type { GearItem } from '../data/gear';
import IconArrow from './IconArrow.astro';

interface Props {
  item: GearItem;
  index: number;
}

const { item, index } = Astro.props;
---

<article
  class:list={[
    'gear-card',
    'group',
    'flex',
    'h-full',
    'flex-col',
    item.category === 'Main Computer' && 'gear-card-laptop',
    item.category === 'Keyboard' && 'gear-card-keyboard',
    item.category === 'Mouse' && 'gear-card-mouse',
  ]}
>
  <div class="gear-card-image project-image relative aspect-[4/3] overflow-hidden">
    <picture>
      <img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" width="1200" height="900" />
    </picture>
    <span
      class="absolute left-4 top-4 bg-[var(--background)]/90 px-3 py-2 text-[0.62rem] font-bold uppercase tracking-[0.14em]"
    >
      0{index + 1}
    </span>
  </div>
  <div class="flex flex-1 flex-col border-b rule pb-7 pt-6">
    <p class="eyebrow">{item.category}</p>
    <h2 class="mt-3 max-w-sm text-[clamp(1.2rem,1.8vw,1.7rem)] font-medium leading-tight tracking-[-0.05em]">
      {item.name}
    </h2>
    <p class="mt-3 max-w-sm text-xs leading-relaxed text-[var(--muted)]">{item.description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        item.details.map((detail) => (
          <span class="rounded-full border rule px-3 py-1 text-[0.68rem] text-[var(--muted)]">{detail}</span>
        ))
      }
    </div>
    <a
      class="gear-product-link mt-auto inline-flex items-center gap-2 pt-6 text-xs font-bold uppercase tracking-[0.14em] text-[var(--foreground)]"
      href={item.productUrl}
      target="_blank"
      rel="noreferrer"
    >
      View Product
      <IconArrow />
    </a>
  </div>
</article>
